{
  "name": "@deepwork/core-host",
  "version": "0.1.0",
  "private": true,
  "description": "内核宿主：托管 Agent 运行时，屏蔽内核差异，向上提供稳定的 stdio JSON-RPC 接口",
  "main": "dist/index.js",
  "bin": {
    "deepwork-host": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "demo": "node dist/cli/demo.js"
  },
  "dependencies": {
    "@deepwork/protocol": "0.1.0"
  }
}
